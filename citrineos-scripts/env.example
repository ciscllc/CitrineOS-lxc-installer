# ============================================================
# CitrineOS Environment Configuration Template
# Version: 2.0.0
# ============================================================
# Kopieren Sie diese Datei als .env und passen Sie die Werte an:
#   cp env.example .env
# ============================================================

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
NODE_ENV=production
PORT=8085
HOST=0.0.0.0
BASE_URL=http://localhost:8085

# ------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=citrineos
DATABASE_USER=citrineos_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT=30000

# ------------------------------------------------------------
# REDIS SETTINGS
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ------------------------------------------------------------
# OCPP WEBSOCKET CONFIGURATION
# ------------------------------------------------------------
OCPP_WEBSOCKET_PORT=8080
OCPP_SECURE_WEBSOCKET_PORT=9000
OCPP_WEBSOCKET_PATH=/ocpp/{chargePointId}
OCPP_MAX_CONNECTIONS=1000
OCPP_HEARTBEAT_INTERVAL=30
OCPP_BOOT_RETRY_INTERVAL=60
OCPP_SUPPORTED_VERSIONS=1.6,2.0.1

# ------------------------------------------------------------
# GOOGLE MAPS INTEGRATION
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_DEFAULT_LAT=52.5200
GOOGLE_MAPS_DEFAULT_LNG=13.4050
GOOGLE_MAPS_DEFAULT_ZOOM=12

# ------------------------------------------------------------
# SSL/TLS SETTINGS
# ------------------------------------------------------------
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/citrineos.crt
SSL_KEY_PATH=/etc/ssl/private/citrineos.key
SSL_CA_PATH=

# Let's Encrypt (optional)
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_DOMAIN=citrineos.example.com

# ------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=/opt/citrineos/logs
LOG_FORMAT=json
LOG_MAX_FILES=30
LOG_MAX_SIZE=10M

# ------------------------------------------------------------
# SECURITY SETTINGS - JWT
# ------------------------------------------------------------
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=citrineos

# ------------------------------------------------------------
# SECURITY SETTINGS - SESSION
# ------------------------------------------------------------
SESSION_SECRET=your_session_secret_minimum_32_characters
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------
# SECURITY SETTINGS - RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_TRUSTED_IPS=true

# ------------------------------------------------------------
# SECURITY SETTINGS - CORS
# ------------------------------------------------------------
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ------------------------------------------------------------
# SECURITY SETTINGS - API
# ------------------------------------------------------------
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT_PER_MINUTE=60
API_BCRYPT_ROUNDS=10

# ------------------------------------------------------------
# FILE PATHS
# ------------------------------------------------------------
INSTALL_DIR=/opt/citrineos
BACKUP_DIR=/opt/citrineos/backups
UPLOAD_DIR=/opt/citrineos/uploads
TEMP_DIR=/tmp/citrineos

# ------------------------------------------------------------
# ADMIN USER SETTINGS
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------
# BACKUP SETTINGS
# ------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_DAYS=7
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# ------------------------------------------------------------
# MONITORING & METRICS
# ------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ------------------------------------------------------------
# CHARGE POINT SETTINGS
# ------------------------------------------------------------
CHARGE_POINT_AUTO_AUTHORIZE=true
CHARGE_POINT_RESERVATION_TIMEOUT=300
CHARGE_POINT_TRANSACTION_TIMEOUT=86400

# ------------------------------------------------------------
# NOTIFICATION SETTINGS (optional)
# ------------------------------------------------------------
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=noreply@example.com
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=

# ------------------------------------------------------------
# ADVANCED SETTINGS
# ------------------------------------------------------------
WORKER_THREADS=4
MAX_SOCKET_CONNECTIONS=1000
SOCKET_TIMEOUT=120000
GRACEFUL_SHUTDOWN_TIMEOUT=30000
